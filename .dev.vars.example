# Copy to .dev.vars for `wrangler dev`. NEVER commit .dev.vars.
GROQ_API_KEY=gsk_xxx
AUTH_SECRET=generate-with-openssl-rand-base64-33
# Optional sign-in providers (guest mode works without them)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local storage: either use R2's local emulation (STORAGE_DRIVER=r2 + r2_buckets in wrangler.jsonc) or real AWS keys:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ADMIN_TOKEN=local-admin-token
# Local overrides for non-secret vars
PUBLIC_ORIGIN=http://localhost:8787
