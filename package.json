{
  "name": "netlaunch",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Describe a website by typing or talking; NetLaunch builds it with AI and publishes it at yourdomain/name.",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "dev:full": "vite build && wrangler dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p . && tsc -p tsconfig.test.json",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "icons": "node scripts/make-icons.mjs",
    "oidc:keygen": "node scripts/gen-oidc-key.mjs",
    "db:migrate:local": "wrangler d1 migrations apply netlaunch --local",
    "db:migrate:remote": "wrangler d1 migrations apply netlaunch --remote"
  },
  "dependencies": {
    "@auth/core": "^0.40.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
